# api/.env olarak kopyalayın; .env depoya girmez.
ENV=dev
DATABASE_URL=postgresql+psycopg://teacher_app:<şifre>@localhost:5432/teacher_dev
# Göçler (Alembic) için sahip rolü
MIGRATIONS_DATABASE_URL=postgresql+psycopg://teacher_owner:<şifre>@localhost:5432/teacher_dev
# Testler: göçler sahip rolüyle, yetki testleri uygulama rolüyle teacher_test'e bağlanır
TEST_DATABASE_URL=postgresql+psycopg://teacher_owner:<şifre>@localhost:5432/teacher_test
TEST_APP_DATABASE_URL=postgresql+psycopg://teacher_app:<şifre>@localhost:5432/teacher_test
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# E-posta (Brevo SMTP). Boş bırakılırsa yerelde giriş bağlantısı loga yazılır.
# Brevo > SMTP & API > SMTP sekmesindeki bilgiler; gönderen adresi doğrulanmış alan adından olmalı.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=giris@alanadi.com
MAIL_FROM_NAME=İngilizce Öğretmenim
